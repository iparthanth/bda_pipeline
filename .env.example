# Copy to .env (or run `make env`, which fills random values). Never commit .env.
# PRV-1: salt for hashing patient IDs (>= 16 chars, kept outside the repository)
EPISCOPE_SALT=
# PRV-3: dashboard access tokens per role (see config/roles.yaml)
EPISCOPE_TOKEN_NATIONAL=
EPISCOPE_TOKEN_DHAKA=
EPISCOPE_TOKEN_BANDARBAN=
EPISCOPE_TOKEN_SYLHET=
# ING-5 (optional): S3-compatible object store (MinIO) - set paths.lake_root to s3a://episcope/lake
S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional overrides, e.g. EPISCOPE__GENERATOR__SCALE_FACTOR=0.25 or EPISCOPE_DATA_ROOT=/big/disk/episcope
